# Copy to .env for local development; never commit real values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# Default: keep the service-role secret inside Supabase, and deploy focal-api.
# SUPABASE_API_FUNCTION_URL defaults to your project's /functions/v1/focal-api.
# SUPABASE_API_FUNCTION_URL=https://your-project.supabase.co/functions/v1/focal-api
# Optional direct-server mode only (keep private; not required on Render):
# SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-or-secret-key
APP_URL=http://localhost:5173
PORT=3000
NODE_ENV=development
